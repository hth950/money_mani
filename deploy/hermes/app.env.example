# Copy to /srv/money-mani/secrets/app.env with mode 600.
# Never commit the populated file.

OPENROUTER_KEY=
DISCORD_WEBHOOK_URL=
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KIS_API_KEY=
KIS_API_SECRET=
KIS_HTS_ID=
KIS_ACCOUNT_NUMBER=

# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MONEY_MANI_INTERNAL_TOKEN=

# Add the exact Funnel hostname (without scheme/port) once Tailscale assigns it.
MONEY_MANI_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Fill after `tailscale funnel status` prints the exact public URL.
# Example: https://money-mani-hermes.example-tailnet.ts.net:8443
MONEY_MANI_ALLOWED_ORIGINS=
